# ==========================================================
# JARVIS — AI Desktop Agent Configuration
# ==========================================================

# 1. LLM Brain Provider Configuration
# Supported providers: openai_compatible, anthropic, ollama, mock
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60.0
LLM_MAX_ITERATIONS=8

# 2. Voice & Speech Synthesis
ENABLE_VOICE=true
ENABLE_WAKE_WORD=false
WAKE_WORD=hey jarvis
STT_PROVIDER=fallback
TTS_PROVIDER=pyttsx3
TTS_VOICE=
TTS_RATE=175
TTS_VOLUME=1.0

# 3. Vision & Study Monitoring (Disabled by default for privacy)
ENABLE_CAMERA=false
CAMERA_INDEX=0
STUDY_EYE_DETECTION=false
STUDY_ATTENTION_DETECTION=false
EYE_CLOSURE_THRESHOLD=4.0
ATTENTION_AWAY_THRESHOLD=7.0

# 4. Browser Automation
ENABLE_BROWSER=true
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30.0

# 5. Security & Permission Policies
CONFIRM_HIGH_RISK=true
CONFIRM_MEDIUM_RISK=false
ALLOWED_FS_ROOTS=
ALLOW_SHELL_COMMANDS=false

# 6. Persistence & Diagnostics
DATABASE_PATH=data/jarvis.db
LOG_LEVEL=INFO
DEVELOPER_MODE=false
